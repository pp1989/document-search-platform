# ===============================
# Application
# ===============================
APP_NAME=Document Search Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ===============================
# Server
# ===============================
HOST=0.0.0.0
PORT=8000

# ===============================
# Logging
# ===============================
LOG_LEVEL=INFO

# ===============================
# PostgreSQL
# ===============================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ===============================
# Ollama
# ===============================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ===============================
# Phoenix
# ===============================
PHOENIX_ENDPOINT=http://localhost:6006

# ===============================
# Upload
# ===============================
UPLOAD_DIR=uploads